{
  "dpt_version": 1,
  "audio": { "inputs": ["L", "R"], "outputs": ["L", "R"] },
  "nodes": {
    "input":  { "type": "input",  "outputs": ["L", "R"] },
    "crunchy": {
      "type": "crunchy",
      "inputs": ["in"], "outputs": ["out"],
      "params": {
        "drive": 0.9,
        "bits": 16.0,
        "downsample": 7.0,
        "mix": 1.0
      }
    },
    "output": { "type": "output", "inputs": ["L", "R"] }
  },
  "connections": [
    { "from": "input:L",     "to": "crunchy:in" },
    { "from": "crunchy:out", "to": "output:L" },
    { "from": "crunchy:out", "to": "output:R" }
  ]
}

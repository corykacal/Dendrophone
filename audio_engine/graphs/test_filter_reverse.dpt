{
  "dpt_version": 1,
  "audio": {
    "inputs": ["L", "R"],
    "outputs": ["L", "R"]
  },
  "nodes": {
    "input": {
      "type": "input",
      "outputs": ["L", "R"]
    },
    "lfo_cutoff": {
      "type": "lfo",
      "rate": "control",
      "outputs": ["value"],
      "params": {
        "wave": "sine",
        "freq_hz": 0.4,
        "depth": 600.0
      }
    },
    "filter": {
      "type": "svfilter",
      "inputs": ["in"],
      "outputs": ["out"],
      "param_inputs": ["cutoff"],
      "params": {
        "mode": "lowpass",
        "cutoff": 800.0,
        "resonance": 3.0,
        "mix": 1.0
      }
    },
    "reverse": {
      "type": "reverse",
      "inputs": ["in"],
      "outputs": ["out"],
      "params": {
        "buffer_time_ms": 600.0,
        "mix": 1.0,
        "enabled": 1.0
      }
    },
    "output": {
      "type": "output",
      "inputs": ["L", "R"]
    }
  },
  "connections": [
    { "from": "input:L", "to": "filter:in" },
    { "from": "lfo_cutoff:value", "to": "filter:cutoff" },
    { "from": "filter:out", "to": "reverse:in" },
    { "from": "reverse:out", "to": "output:L" },
    { "from": "reverse:out", "to": "output:R" }
  ]
}

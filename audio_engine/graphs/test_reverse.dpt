{
  "dpt_version": 1,
  "audio": { "inputs": ["L", "R"], "outputs": ["L", "R"] },
  "nodes": {
    "input":  { "type": "input",  "outputs": ["L", "R"] },
    "reverse": {
      "type": "reverse",
      "inputs": ["in"], "outputs": ["out"],
      "params": {
        "buffer_time_ms": 500.0,
        "enabled": 1.0,
        "mix": 1.0
      }
    },
    "output": { "type": "output", "inputs": ["L", "R"] }
  },
  "connections": [
    { "from": "input:L",     "to": "reverse:in" },
    { "from": "reverse:out", "to": "output:L" },
    { "from": "reverse:out", "to": "output:R" }
  ]
}

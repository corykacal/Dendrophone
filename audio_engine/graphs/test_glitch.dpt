{
  "dpt_version": 1,
  "audio": { "inputs": ["L", "R"], "outputs": ["L", "R"] },
  "nodes": {
    "input":  { "type": "input",  "outputs": ["L", "R"] },
    "glitch": {
      "type": "glitch",
      "inputs": ["in"], "outputs": ["out"],
      "params": {
        "freeze": 0.2,
        "stutter_rate_hz": 10.5,
        "capture_size_ms": 800.0,
        "speed": 1.8,
        "randomize": 0.9,
        "mix": 1.0
      }
    },
    "output": { "type": "output", "inputs": ["L", "R"] }
  },
  "connections": [
    { "from": "input:L",    "to": "glitch:in" },
    { "from": "glitch:out", "to": "output:L" },
    { "from": "glitch:out", "to": "output:R" }
  ]
}

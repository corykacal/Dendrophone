{
  "dpt_version": 1,
  "audio": { "inputs": ["L", "R"], "outputs": ["L", "R"] },
  "nodes": {
    "input":  { "type": "input",  "outputs": ["L", "R"] },
    "flanger": {
      "type": "flanger",
      "inputs": ["in"], "outputs": ["out"],
      "params": {
        "rate_hz": 1.5,
        "depth": 0.8,
        "feedback": 0.8,
        "delay_ms": 10.0,
        "mix": 1.0
      }
    },
    "output": { "type": "output", "inputs": ["L", "R"] }
  },
  "connections": [
    { "from": "input:L",      "to": "flanger:in" },
    { "from": "flanger:out",  "to": "output:L" },
    { "from": "flanger:out",  "to": "output:R" }
  ]
}

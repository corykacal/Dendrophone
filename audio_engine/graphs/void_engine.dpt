{
  "dpt_version": 1,
  "audio": {
    "inputs": ["L", "R"],
    "outputs": ["L", "R"]
  },
  "nodes": {
    "input": {
      "type": "input",
      "outputs": ["L", "R"]
    },

    "lfo_pitch_wobble": {
      "type": "lfo", "rate": "control", "outputs": ["value"],
      "params": { "wave": "sine", "freq_hz": 0.07, "depth": 1.5 }
    },
    "lfo_gate_sub": {
      "type": "lfo", "rate": "control", "outputs": ["value"],
      "params": { "wave": "square", "freq_hz": 0.5, "depth": 0.5 }
    },
    "lfo_reverse_drift": {
      "type": "lfo", "rate": "control", "outputs": ["value"],
      "params": { "wave": "triangle", "freq_hz": 0.025, "depth": 0.5 }
    },
    "lfo_gran_scatter": {
      "type": "lfo", "rate": "control", "outputs": ["value"],
      "params": { "wave": "random", "freq_hz": 0.15, "depth": 60.0 }
    },
    "lfo_gran_density": {
      "type": "lfo", "rate": "control", "outputs": ["value"],
      "params": { "wave": "random", "freq_hz": 0.12, "depth": 5.0 }
    },
    "lfo_stutter_wild": {
      "type": "lfo", "rate": "control", "outputs": ["value"],
      "params": { "wave": "random", "freq_hz": 0.2, "depth": 4.0 }
    },
    "lfo_chorus_pulse": {
      "type": "lfo", "rate": "control", "outputs": ["value"],
      "params": { "wave": "square", "freq_hz": 0.25, "depth": 0.35 }
    },
    "lfo_reverb_swell": {
      "type": "lfo", "rate": "control", "outputs": ["value"],
      "params": { "wave": "sine", "freq_hz": 0.04, "depth": 0.1 }
    },

    "pitch_sub": {
      "type": "pitch_shift",
      "inputs": ["in"], "outputs": ["out"],
      "param_inputs": ["pitch"],
      "params": { "pitch": -12.0, "mix": 1.0 }
    },
    "lowpass_sub": {
      "type": "svfilter",
      "inputs": ["in"], "outputs": ["out"],
      "param_inputs": ["mix"],
      "params": { "mode": "lowpass", "cutoff": 700.0, "resonance": 1.8, "mix": 0.5 }
    },

    "reverse": {
      "type": "reverse",
      "inputs": ["in"], "outputs": ["out"],
      "param_inputs": ["enabled"],
      "params": { "buffer_time_ms": 1000.0, "enabled": 0.5, "mix": 1.0 }
    },
    "bandpass_mid": {
      "type": "svfilter",
      "inputs": ["in"], "outputs": ["out"],
      "params": { "mode": "bandpass", "cutoff": 900.0, "resonance": 2.5, "mix": 1.0 }
    },

    "granular": {
      "type": "granular",
      "inputs": ["in"], "outputs": ["out"],
      "param_inputs": ["position_random", "density"],
      "params": {
        "grain_size_ms": 90.0,
        "density": 10.0,
        "pitch_shift": -3.0,
        "pitch_random": 2.5,
        "position_random": 50.0,
        "window": "blackman",
        "mix": 1.0
      }
    },

    "mix_raw": {
      "type": "mix",
      "inputs": ["in_a", "in_b", "in_c"],
      "outputs": ["out"]
    },
    "gain_raw": {
      "type": "gain",
      "inputs": ["in"], "outputs": ["out"],
      "params": { "gain": 0.35 }
    },

    "compressor": {
      "type": "compressor",
      "inputs": ["in"], "outputs": ["out"],
      "params": {
        "threshold_db": -18.0,
        "ratio": 4.0,
        "attack_ms": 8.0,
        "release_ms": 120.0,
        "makeup_gain_db": 10.0,
        "mix": 1.0
      }
    },

    "glitch": {
      "type": "glitch",
      "inputs": ["in"], "outputs": ["out"],
      "param_inputs": ["stutter_rate_hz"],
      "params": {
        "freeze": 0.0,
        "stutter_rate_hz": 6.0,
        "capture_size_ms": 280.0,
        "speed": 1.0,
        "randomize": 0.45,
        "mix": 0.65
      }
    },

    "chorus": {
      "type": "chorus",
      "inputs": ["in"], "outputs": ["out"],
      "param_inputs": ["depth"],
      "params": { "rate_hz": 0.2, "depth": 0.55, "voices": 4, "stereo_width": 0.9, "mix": 0.65 }
    },

    "reverb": {
      "type": "reverb",
      "inputs": ["in"], "outputs": ["out"],
      "param_inputs": ["decay"],
      "params": { "decay": 0.88, "room_size": 0.95, "damping": 0.2, "pre_delay_ms": 30.0, "mix": 0.65 }
    },

    "output": { "type": "output", "inputs": ["L", "R"] }
  },

  "connections": [
    { "from": "input:L",                "to": "pitch_sub:in" },
    { "from": "lfo_pitch_wobble:value", "to": "pitch_sub:pitch" },
    { "from": "pitch_sub:out",          "to": "lowpass_sub:in" },
    { "from": "lfo_gate_sub:value",     "to": "lowpass_sub:mix" },

    { "from": "input:L",                 "to": "reverse:in" },
    { "from": "lfo_reverse_drift:value", "to": "reverse:enabled" },
    { "from": "reverse:out",             "to": "bandpass_mid:in" },

    { "from": "input:L",                 "to": "granular:in" },
    { "from": "lfo_gran_scatter:value",  "to": "granular:position_random" },
    { "from": "lfo_gran_density:value",  "to": "granular:density" },

    { "from": "lowpass_sub:out",   "to": "mix_raw:in_a" },
    { "from": "bandpass_mid:out",  "to": "mix_raw:in_b" },
    { "from": "granular:out",      "to": "mix_raw:in_c" },

    { "from": "mix_raw:out",       "to": "gain_raw:in" },
    { "from": "gain_raw:out",      "to": "compressor:in" },

    { "from": "compressor:out",         "to": "glitch:in" },
    { "from": "lfo_stutter_wild:value", "to": "glitch:stutter_rate_hz" },

    { "from": "glitch:out",             "to": "chorus:in" },
    { "from": "lfo_chorus_pulse:value", "to": "chorus:depth" },

    { "from": "chorus:out",             "to": "reverb:in" },
    { "from": "lfo_reverb_swell:value", "to": "reverb:decay" },

    { "from": "reverb:out",  "to": "output:L" },
    { "from": "reverb:out",  "to": "output:R" }
  ]
}

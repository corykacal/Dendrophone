{
  "dpt_version": 1,
  "audio": { "inputs": ["L", "R"], "outputs": ["L", "R"] },
  "nodes": {
    "input":  { "type": "input",  "outputs": ["L", "R"] },
    "overdrive": {
      "type": "overdrive",
      "inputs": ["in"], "outputs": ["out"],
      "params": {
        "drive": 0.6,
        "tone": 0.5,
        "level": 1.0,
        "type": "soft",
        "mix": 1.0
      }
    },
    "output": { "type": "output", "inputs": ["L", "R"] }
  },
  "connections": [
    { "from": "input:L",       "to": "overdrive:in" },
    { "from": "overdrive:out", "to": "output:L" },
    { "from": "overdrive:out", "to": "output:R" }
  ]
}

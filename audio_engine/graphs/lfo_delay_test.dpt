{
  "dpt_version": 1,
  "audio": {
    "inputs": ["L", "R"],
    "outputs": ["L", "R"]
  },

  "nodes": {
    "input": {
      "type": "input",
      "outputs": ["L", "R"]
    },

    "lfo1": {
      "type": "lfo",
      "rate": "control",
      "outputs": ["value"],
      "params": {
        "wave": "sine",
        "freq_hz": 0.5,
        "depth": 100.0
      }
    },

    "delay_R": {
      "type": "delay",
      "inputs": ["in"],
      "outputs": ["out"],
      "param_inputs": ["time_ms", "feedback", "mix"],
      "params": {
        "time_ms": 300.0,
        "feedback": 0.4,
        "mix": 0.7
      }
    },

    "output": {
      "type": "output",
      "inputs": ["L", "R"]
    }
  },

  "connections": [
    { "from": "input:L", "to": "output:L" },
    { "from": "input:R", "to": "delay_R:in" },

    { "from": "lfo1:value", "to": "delay_R:time_ms" },

    { "from": "delay_R:out", "to": "output:R" }
  ]
}

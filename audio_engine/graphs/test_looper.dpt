{
  "dpt_version": 1,
  "audio": { "inputs": ["L", "R"], "outputs": ["L", "R"] },
  "nodes": {
    "input":  { "type": "input",  "outputs": ["L", "R"] },
    "looper": {
      "type": "looper",
      "inputs": ["in"], "outputs": ["out"],
      "params": {
        "speed": 1.3,
        "feedback": 0.8,
        "mix": 1.0,
        "record_trigger": 1.0,
        "play_trigger": 1.0,
        "overdub_trigger": 1.0,
        "clear_trigger": 1.0
      }
    },
    "output": { "type": "output", "inputs": ["L", "R"] }
  },
  "connections": [
    { "from": "input:L",    "to": "looper:in" },
    { "from": "looper:out", "to": "output:L" },
    { "from": "looper:out", "to": "output:R" }
  ]
}

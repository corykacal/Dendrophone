{
  "dpt_version": 1,
  "audio": { "inputs": ["L", "R"], "outputs": ["L", "R"] },
  "nodes": {
    "input":  { "type": "input",  "outputs": ["L", "R"] },
    "reverb": {
      "type": "reverb",
      "inputs": ["in"], "outputs": ["out"],
      "params": {
        "decay": 0.75,
        "room_size": 0.9,
        "damping": 0.3,
        "pre_delay_ms": 15.0,
        "mix": 1.0
      }
    },
    "output": { "type": "output", "inputs": ["L", "R"] }
  },
  "connections": [
    { "from": "input:L",    "to": "reverb:in" },
    { "from": "reverb:out", "to": "output:L" },
    { "from": "reverb:out", "to": "output:R" }
  ]
}

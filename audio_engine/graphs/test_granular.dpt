{
  "dpt_version": 1,
  "audio": { "inputs": ["L", "R"], "outputs": ["L", "R"] },
  "nodes": {
    "input":  { "type": "input",  "outputs": ["L", "R"] },
    "granular": {
      "type": "granular",
      "inputs": ["in"], "outputs": ["out"],
      "params": {
        "grain_size_ms": 100.0,
        "density": 2.0,
        "pitch_shift": -5.0,
        "pitch_random": 3.0,
        "position_random": 1.0,
        "window": "hann",
        "mix": 1.0
      }
    },
    "output": { "type": "output", "inputs": ["L", "R"] }
  },
  "connections": [
    { "from": "input:L",      "to": "granular:in" },
    { "from": "granular:out", "to": "output:L" },
    { "from": "granular:out", "to": "output:R" }
  ]
}

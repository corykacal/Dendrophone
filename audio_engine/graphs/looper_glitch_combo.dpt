{
  "dpt_version": 1,
  "audio": {
    "inputs": ["L", "R"],
    "outputs": ["L", "R"]
  },
  "nodes": {
    "input": {
      "type": "input",
      "outputs": ["L", "R"]
    },
    "lfo_freeze": {
      "type": "lfo",
      "rate": "control",
      "outputs": ["value"],
      "params": {
        "wave": "square",
        "freq_hz": 0.5,
        "depth": 0.5
      }
    },
    "looper": {
      "type": "looper",
      "inputs": ["in"],
      "outputs": ["out"],
      "params": {
        "speed": 1.0,
        "feedback": 0.7,
        "mix": 1.0,
        "record_trigger": 0.0,
        "play_trigger": 0.0,
        "overdub_trigger": 0.0,
        "clear_trigger": 0.0
      }
    },
    "glitch": {
      "type": "glitch",
      "inputs": ["in"],
      "outputs": ["out"],
      "param_inputs": ["freeze"],
      "params": {
        "freeze": 0.5,
        "stutter_rate_hz": 8.0,
        "capture_size_ms": 100.0,
        "speed": 1.0,
        "randomize": 0.5,
        "mix": 0.7
      }
    },
    "output": {
      "type": "output",
      "inputs": ["L", "R"]
    }
  },
  "connections": [
    { "from": "input:L", "to": "looper:in" },
    { "from": "looper:out", "to": "glitch:in" },
    { "from": "lfo_freeze:value", "to": "glitch:freeze" },
    { "from": "glitch:out", "to": "output:L" },
    { "from": "glitch:out", "to": "output:R" }
  ]
}

{
  "dpt_version": 1,
  "audio": {
    "inputs": ["L", "R"],
    "outputs": ["L", "R"]
  },
  "nodes": {
    "input": {
      "type": "input",
      "outputs": ["L", "R"]
    },
    "compressor": {
      "type": "compressor",
      "inputs": ["in"],
      "outputs": ["out"],
      "params": {
        "threshold_db": -20.0,
        "ratio": 4.0,
        "attack_ms": 10.0,
        "release_ms": 100.0,
        "makeup_gain_db": 6.0,
        "mix": 1.0
      }
    },
    "output": {
      "type": "output",
      "inputs": ["L", "R"]
    }
  },
  "connections": [
    { "from": "input:L", "to": "compressor:in" },
    { "from": "compressor:out", "to": "output:L" },
    { "from": "compressor:out", "to": "output:R" }
  ]
}

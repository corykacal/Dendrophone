{
  "dpt_version": 1,
  "audio": {
    "inputs": ["L", "R"],
    "outputs": ["L", "R"]
  },
  "nodes": {
    "input": {
      "type": "input",
      "outputs": ["L", "R"]
    },
    "pitch_down_octave": {
      "type": "pitch_shift",
      "inputs": ["in"],
      "outputs": ["out"],
      "params": {
        "pitch": -12.0,
        "mix": 1.0
      }
    },
    "pitch_original": {
      "type": "pitch_shift",
      "inputs": ["in"],
      "outputs": ["out"],
      "params": {
        "pitch": 0.0,
        "mix": 1.0
      }
    },
    "pitch_up_octave": {
      "type": "pitch_shift",
      "inputs": ["in"],
      "outputs": ["out"],
      "params": {
        "pitch": 12.0,
        "mix": 1.0
      }
    },
    "mix_octaves": {
      "type": "mix",
      "inputs": ["in_a", "in_b", "in_c"],
      "outputs": ["out"]
    },
    "gain_normalize": {
      "type": "gain",
      "inputs": ["in"],
      "outputs": ["out"],
      "params": {
        "gain": 0.33
      }
    },
    "output": {
      "type": "output",
      "inputs": ["L", "R"]
    }
  },
  "connections": [
    { "from": "input:L", "to": "pitch_down_octave:in" },
    { "from": "input:L", "to": "pitch_original:in" },
    { "from": "input:L", "to": "pitch_up_octave:in" },
    { "from": "pitch_down_octave:out", "to": "mix_octaves:in_a" },
    { "from": "pitch_original:out", "to": "mix_octaves:in_b" },
    { "from": "pitch_up_octave:out", "to": "mix_octaves:in_c" },
    { "from": "mix_octaves:out", "to": "gain_normalize:in" },
    { "from": "gain_normalize:out", "to": "output:L" },
    { "from": "gain_normalize:out", "to": "output:R" }
  ]
}

{
  "dpt_version": 1,
  "audio": {
    "inputs": ["L", "R"],
    "outputs": ["L", "R"]
  },
  "nodes": {
    "input": {
      "type": "input",
      "outputs": ["L", "R"]
    },
    "lfo_filter_slow": {
      "type": "lfo",
      "rate": "control",
      "outputs": ["value"],
      "params": {
        "wave": "sine",
        "freq_hz": 0.08,
        "depth": 600.0
      }
    },
    "lfo_reverb_decay": {
      "type": "lfo",
      "rate": "control",
      "outputs": ["value"],
      "params": {
        "wave": "triangle",
        "freq_hz": 0.12,
        "depth": 0.15
      }
    },
    "lfo_reverse_morph": {
      "type": "lfo",
      "rate": "control",
      "outputs": ["value"],
      "params": {
        "wave": "sine",
        "freq_hz": 0.05,
        "depth": 0.4
      }
    },
    "lfo_pitch_shimmer": {
      "type": "lfo",
      "rate": "control",
      "outputs": ["value"],
      "params": {
        "wave": "sine",
        "freq_hz": 0.15,
        "depth": 0.3
      }
    },
    "filter_input": {
      "type": "svfilter",
      "inputs": ["in"],
      "outputs": ["out"],
      "param_inputs": ["cutoff"],
      "params": {
        "mode": "lowpass",
        "cutoff": 1200.0,
        "resonance": 1.5,
        "mix": 1.0
      }
    },
    "pitch_root": {
      "type": "pitch_shift",
      "inputs": ["in"],
      "outputs": ["out"],
      "param_inputs": ["pitch"],
      "params": {
        "pitch": 0.0,
        "mix": 1.0
      }
    },
    "pitch_octave_up": {
      "type": "pitch_shift",
      "inputs": ["in"],
      "outputs": ["out"],
      "params": {
        "pitch": 12.0,
        "mix": 1.0
      }
    },
    "pitch_fifth": {
      "type": "pitch_shift",
      "inputs": ["in"],
      "outputs": ["out"],
      "params": {
        "pitch": 7.0,
        "mix": 1.0
      }
    },
    "mix_harmony": {
      "type": "mix",
      "inputs": ["in_a", "in_b", "in_c"],
      "outputs": ["out"]
    },
    "gain_harmony": {
      "type": "gain",
      "inputs": ["in"],
      "outputs": ["out"],
      "params": {
        "gain": 0.35
      }
    },
    "multitap_texture": {
      "type": "multitap_delay",
      "inputs": ["in"],
      "outputs": ["out"],
      "params": {
        "tap0_time_ms": 89.0,
        "tap0_gain": 0.7,
        "tap1_time_ms": 233.0,
        "tap1_gain": 0.6,
        "tap2_time_ms": 377.0,
        "tap2_gain": 0.5,
        "tap3_time_ms": 521.0,
        "tap3_gain": 0.4,
        "tap4_time_ms": 699.0,
        "tap4_gain": 0.3,
        "feedback": 0.4,
        "mix": 0.6
      }
    },
    "reverse_texture": {
      "type": "reverse",
      "inputs": ["in"],
      "outputs": ["out"],
      "param_inputs": ["enabled"],
      "params": {
        "buffer_time_ms": 900.0,
        "mix": 0.35,
        "enabled": 0.5
      }
    },
    "reverb_space": {
      "type": "reverb",
      "inputs": ["in"],
      "outputs": ["out"],
      "param_inputs": ["decay"],
      "params": {
        "decay": 0.75,
        "mix": 0.5,
        "room_size": 0.9
      }
    },
    "output": {
      "type": "output",
      "inputs": ["L", "R"]
    }
  },
  "connections": [
    { "from": "input:L", "to": "filter_input:in" },
    { "from": "lfo_filter_slow:value", "to": "filter_input:cutoff" },

    { "from": "filter_input:out", "to": "pitch_root:in" },
    { "from": "filter_input:out", "to": "pitch_octave_up:in" },
    { "from": "filter_input:out", "to": "pitch_fifth:in" },
    { "from": "lfo_pitch_shimmer:value", "to": "pitch_root:pitch" },

    { "from": "pitch_root:out", "to": "mix_harmony:in_a" },
    { "from": "pitch_octave_up:out", "to": "mix_harmony:in_b" },
    { "from": "pitch_fifth:out", "to": "mix_harmony:in_c" },

    { "from": "mix_harmony:out", "to": "gain_harmony:in" },
    { "from": "gain_harmony:out", "to": "multitap_texture:in" },
    { "from": "multitap_texture:out", "to": "reverse_texture:in" },
    { "from": "lfo_reverse_morph:value", "to": "reverse_texture:enabled" },

    { "from": "reverse_texture:out", "to": "reverb_space:in" },
    { "from": "lfo_reverb_decay:value", "to": "reverb_space:decay" },

    { "from": "reverb_space:out", "to": "output:L" },
    { "from": "reverb_space:out", "to": "output:R" }
  ]
}

{
  "dpt_version": 1,
  "audio": {
    "inputs": ["L", "R"],
    "outputs": ["L", "R"]
  },
  "nodes": {
    "input": {
      "type": "input",
      "outputs": ["L", "R"]
    },
    "delay": {
      "type": "delay",
      "inputs": ["in"],
      "outputs": ["out"],
      "params": {
        "time_ms": 250,
        "feedback": 0.4,
        "mix": 0.5
      }
    },
    "output": {
      "type": "output",
      "inputs": ["L", "R"]
    }
  },
  "connections": [
    { "from": "input:L", "to": "delay:in" },
    { "from": "input:R", "to": "delay:in" },
    { "from": "delay:out", "to": "output:L" },
    { "from": "delay:out", "to": "output:R" }
  ]
}

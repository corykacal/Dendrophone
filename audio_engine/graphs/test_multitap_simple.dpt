{
  "dpt_version": 1,
  "audio": {
    "inputs": ["L", "R"],
    "outputs": ["L", "R"]
  },
  "nodes": {
    "input": {
      "type": "input",
      "outputs": ["L", "R"]
    },
    "multitap": {
      "type": "multitap_delay",
      "inputs": ["in"],
      "outputs": ["out"],
      "params": {
        "tap0_time_ms": 150.0,
        "tap0_gain": 0.8,
        "tap1_time_ms": 300.0,
        "tap1_gain": 0.6,
        "tap2_time_ms": 450.0,
        "tap2_gain": 0.4,
        "tap3_time_ms": 600.0,
        "tap3_gain": 0.3,
        "feedback": 0.3,
        "mix": 0.5
      }
    },
    "output": {
      "type": "output",
      "inputs": ["L", "R"]
    }
  },
  "connections": [
    { "from": "input:L", "to": "multitap:in" },
    { "from": "multitap:out", "to": "output:L" },
    { "from": "multitap:out", "to": "output:R" }
  ]
}

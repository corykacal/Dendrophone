{
  "dpt_version": 1,
  "audio": {
    "inputs": ["L", "R"],
    "outputs": ["L", "R"]
  },
  "nodes": {
    "input": {
      "type": "input",
      "outputs": ["L", "R"]
    },
    "lfo1": {
      "type": "lfo",
      "rate": "control",
      "outputs": ["value"],
      "params": {
        "wave": "sine",
        "freq_hz": 0.5,
        "depth": 3.0
      }
    },
    "pitch_shift": {
      "type": "pitch_shift",
      "inputs": ["in"],
      "outputs": ["out"],
      "param_inputs": ["pitch"],
      "params": {
        "pitch": 0.0,
        "mix": 0.8
      }
    },
    "output": {
      "type": "output",
      "inputs": ["L", "R"]
    }
  },
  "connections": [
    { "from": "input:L", "to": "pitch_shift:in" },
    { "from": "input:R", "to": "pitch_shift:in" },
    { "from": "lfo1:value", "to": "pitch_shift:pitch" },
    { "from": "pitch_shift:out", "to": "output:L" },
    { "from": "pitch_shift:out", "to": "output:R" }
  ]
}

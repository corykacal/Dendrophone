{
  "dpt_version": 1,
  "audio": {
    "inputs": ["L", "R"],
    "outputs": ["L", "R"]
  },
  "nodes": {
    "input": {
      "type": "input",
      "outputs": ["L", "R"]
    },

    "lfo_drive_pulse": {
      "type": "lfo", "rate": "control", "outputs": ["value"],
      "params": { "wave": "triangle", "freq_hz": 0.08, "depth": 0.3 }
    },
    "lfo_grain_morph": {
      "type": "lfo", "rate": "control", "outputs": ["value"],
      "params": { "wave": "sine", "freq_hz": 0.05, "depth": 30.0 }
    },
    "lfo_stutter_chaos": {
      "type": "lfo", "rate": "control", "outputs": ["value"],
      "params": { "wave": "random", "freq_hz": 0.18, "depth": 3.0 }
    },
    "lfo_tremolo_rate": {
      "type": "lfo", "rate": "control", "outputs": ["value"],
      "params": { "wave": "sine", "freq_hz": 0.04, "depth": 1.5 }
    },
    "lfo_filter_warm": {
      "type": "lfo", "rate": "control", "outputs": ["value"],
      "params": { "wave": "triangle", "freq_hz": 0.06, "depth": 1500.0 }
    },

    "overdrive": {
      "type": "overdrive",
      "inputs": ["in"], "outputs": ["out"],
      "param_inputs": ["drive"],
      "params": { "drive": 0.45, "tone": 0.6, "level": 1.0, "type": "soft", "mix": 0.85 }
    },

    "granular": {
      "type": "granular",
      "inputs": ["in"], "outputs": ["out"],
      "param_inputs": ["grain_size_ms"],
      "params": {
        "grain_size_ms": 70.0,
        "density": 12.0,
        "pitch_shift": 0.0,
        "pitch_random": 0.8,
        "position_random": 35.0,
        "window": "hann",
        "mix": 0.75
      }
    },

    "glitch": {
      "type": "glitch",
      "inputs": ["in"], "outputs": ["out"],
      "param_inputs": ["stutter_rate_hz"],
      "params": {
        "freeze": 0.0,
        "stutter_rate_hz": 5.0,
        "capture_size_ms": 320.0,
        "speed": 1.0,
        "randomize": 0.28,
        "mix": 0.6
      }
    },

    "tremolo": {
      "type": "tremolo",
      "inputs": ["in"], "outputs": ["out"],
      "param_inputs": ["rate_hz"],
      "params": { "rate_hz": 2.5, "depth": 0.6, "waveform": "triangle", "stereo_phase": 0.25, "mix": 0.9 }
    },

    "filter_warm": {
      "type": "svfilter",
      "inputs": ["in"], "outputs": ["out"],
      "param_inputs": ["cutoff"],
      "params": { "mode": "lowpass", "cutoff": 3000.0, "resonance": 1.4, "mix": 0.85 }
    },

    "reverb": {
      "type": "reverb",
      "inputs": ["in"], "outputs": ["out"],
      "params": { "decay": 0.65, "room_size": 0.8, "damping": 0.5, "mix": 0.55 }
    },

    "output": { "type": "output", "inputs": ["L", "R"] }
  },

  "connections": [
    { "from": "input:L",               "to": "overdrive:in" },
    { "from": "lfo_drive_pulse:value", "to": "overdrive:drive" },

    { "from": "overdrive:out",         "to": "granular:in" },
    { "from": "lfo_grain_morph:value", "to": "granular:grain_size_ms" },

    { "from": "granular:out",            "to": "glitch:in" },
    { "from": "lfo_stutter_chaos:value", "to": "glitch:stutter_rate_hz" },

    { "from": "glitch:out",             "to": "tremolo:in" },
    { "from": "lfo_tremolo_rate:value", "to": "tremolo:rate_hz" },

    { "from": "tremolo:out",           "to": "filter_warm:in" },
    { "from": "lfo_filter_warm:value", "to": "filter_warm:cutoff" },

    { "from": "filter_warm:out",       "to": "reverb:in" },

    { "from": "reverb:out",            "to": "output:L" },
    { "from": "reverb:out",            "to": "output:R" }
  ]
}

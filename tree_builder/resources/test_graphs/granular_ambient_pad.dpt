{
  "dpt_version": 1,
  "audio": {
    "inputs": ["L", "R"],
    "outputs": ["L", "R"]
  },
  "nodes": {
    "input": {
      "type": "input",
      "outputs": ["L", "R"]
    },
    "lfo_grain_size": {
      "type": "lfo",
      "rate": "control",
      "outputs": ["value"],
      "params": {
        "wave": "sine",
        "freq_hz": 0.06,
        "depth": 40.0
      }
    },
    "lfo_pitch": {
      "type": "lfo",
      "rate": "control",
      "outputs": ["value"],
      "params": {
        "wave": "triangle",
        "freq_hz": 0.04,
        "depth": 2.0
      }
    },
    "lfo_filter": {
      "type": "lfo",
      "rate": "control",
      "outputs": ["value"],
      "params": {
        "wave": "sine",
        "freq_hz": 0.08,
        "depth": 500.0
      }
    },
    "lfo_reverb": {
      "type": "lfo",
      "rate": "control",
      "outputs": ["value"],
      "params": {
        "wave": "sine",
        "freq_hz": 0.05,
        "depth": 0.1
      }
    },
    "granular": {
      "type": "granular",
      "inputs": ["in"],
      "outputs": ["out"],
      "param_inputs": ["grain_size_ms", "pitch_shift"],
      "params": {
        "grain_size_ms": 100.0,
        "density": 12.0,
        "pitch_shift": 7.0,
        "pitch_random": 1.5,
        "position_random": 80.0,
        "window": "blackman",
        "mix": 0.7
      }
    },
    "filter": {
      "type": "svfilter",
      "inputs": ["in"],
      "outputs": ["out"],
      "param_inputs": ["cutoff"],
      "params": {
        "mode": "lowpass",
        "cutoff": 1200.0,
        "resonance": 1.8,
        "mix": 1.0
      }
    },
    "reverb": {
      "type": "reverb",
      "inputs": ["in"],
      "outputs": ["out"],
      "param_inputs": ["decay"],
      "params": {
        "decay": 0.8,
        "mix": 0.6,
        "room_size": 0.92
      }
    },
    "output": {
      "type": "output",
      "inputs": ["L", "R"]
    }
  },
  "connections": [
    { "from": "input:L", "to": "granular:in" },
    { "from": "lfo_grain_size:value", "to": "granular:grain_size_ms" },
    { "from": "lfo_pitch:value", "to": "granular:pitch_shift" },
    { "from": "granular:out", "to": "filter:in" },
    { "from": "lfo_filter:value", "to": "filter:cutoff" },
    { "from": "filter:out", "to": "reverb:in" },
    { "from": "lfo_reverb:value", "to": "reverb:decay" },
    { "from": "reverb:out", "to": "output:L" },
    { "from": "reverb:out", "to": "output:R" }
  ]
}

{
  "dpt_version": 1,
  "audio": {
    "inputs": ["L", "R"],
    "outputs": ["L", "R"]
  },
  "nodes": {
    "input": {
      "type": "input",
      "outputs": ["L", "R"]
    },
    "lfo_pitch": {
      "type": "lfo",
      "rate": "control",
      "outputs": ["value"],
      "params": {
        "wave": "sine",
        "freq_hz": 0.12,
        "depth": 3.0
      }
    },
    "granular": {
      "type": "granular",
      "inputs": ["in"],
      "outputs": ["out"],
      "param_inputs": ["pitch_shift"],
      "params": {
        "grain_size_ms": 80.0,
        "density": 20.0,
        "pitch_shift": 12.0,
        "pitch_random": 0.5,
        "position_random": 50.0,
        "window": "blackman",
        "mix": 0.6
      }
    },
    "reverb": {
      "type": "reverb",
      "inputs": ["in"],
      "outputs": ["out"],
      "params": {
        "decay": 0.85,
        "mix": 0.5,
        "room_size": 0.9
      }
    },
    "output": {
      "type": "output",
      "inputs": ["L", "R"]
    }
  },
  "connections": [
    { "from": "input:L", "to": "granular:in" },
    { "from": "lfo_pitch:value", "to": "granular:pitch_shift" },
    { "from": "granular:out", "to": "reverb:in" },
    { "from": "reverb:out", "to": "output:L" },
    { "from": "reverb:out", "to": "output:R" }
  ]
}

{
  "dpt_version": 1,
  "metadata": {
    "name": "Envelope Multi-Target Demo",
    "description": "Shows envelope modulating filter and delay simultaneously"
  },
  "audio": {
    "inputs": ["L", "R"],
    "outputs": ["L", "R"]
  },

  "nodes": {
    "input": {
      "type": "input",
      "outputs": ["L", "R"]
    },

    "lfo_gate": {
      "type": "lfo",
      "rate": "control",
      "outputs": ["value"],
      "params": {
        "wave": "square",
        "freq_hz": 0.3,
        "depth": 1.0
      }
    },

    "env1": {
      "type": "envelope",
      "rate": "control",
      "outputs": ["value"],
      "param_inputs": ["gate"],
      "params": {
        "envelope_type": "adsr",
        "attack_ms": 100.0,
        "decay_ms": 300.0,
        "sustain_level": 0.5,
        "release_ms": 500.0
      }
    },

    "filter": {
      "type": "svfilter",
      "inputs": ["in"],
      "outputs": ["out"],
      "param_inputs": ["cutoff"],
      "params": {
        "mode": "lowpass",
        "cutoff": 300.0,
        "resonance": 3.0,
        "mix": 1.0
      }
    },

    "delay": {
      "type": "delay",
      "inputs": ["in"],
      "outputs": ["out"],
      "param_inputs": ["time_ms", "mix"],
      "params": {
        "time_ms": 200.0,
        "feedback": 0.5,
        "mix": 0.3
      }
    },

    "output": {
      "type": "output",
      "inputs": ["L", "R"]
    }
  },

  "connections": [
    { "from": "input:L", "to": "filter:in" },

    { "from": "lfo_gate:value", "to": "env1:gate" },

    { "from": "env1:value", "to": "filter:cutoff" },

    { "from": "filter:out", "to": "delay:in" },

    { "from": "env1:value", "to": "delay:time_ms" },

    { "from": "delay:out", "to": "output:L" },
    { "from": "delay:out", "to": "output:R" }
  ]
}

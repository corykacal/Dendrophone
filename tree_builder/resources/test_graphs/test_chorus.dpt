{
  "dpt_version": 1,
  "audio": {
    "inputs": ["L", "R"],
    "outputs": ["L", "R"]
  },
  "nodes": {
    "input": {
      "type": "input",
      "outputs": ["L", "R"]
    },
    "chorus": {
      "type": "chorus",
      "inputs": ["in"],
      "outputs": ["out"],
      "params": {
        "rate_hz": 1.5,
        "depth": 0.6,
        "voices": 3,
        "stereo_width": 0.5,
        "mix": 0.5
      }
    },
    "output": {
      "type": "output",
      "inputs": ["L", "R"]
    }
  },
  "connections": [
    { "from": "input:L", "to": "chorus:in" },
    { "from": "chorus:out", "to": "output:L" },
    { "from": "chorus:out", "to": "output:R" }
  ]
}

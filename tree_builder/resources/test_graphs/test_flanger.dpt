{
  "dpt_version": 1,
  "audio": {
    "inputs": ["L", "R"],
    "outputs": ["L", "R"]
  },
  "nodes": {
    "input": {
      "type": "input",
      "outputs": ["L", "R"]
    },
    "flanger": {
      "type": "flanger",
      "inputs": ["in"],
      "outputs": ["out"],
      "params": {
        "rate_hz": 0.5,
        "depth": 0.8,
        "feedback": 0.6,
        "delay_ms": 2.5,
        "mix": 0.6
      }
    },
    "output": {
      "type": "output",
      "inputs": ["L", "R"]
    }
  },
  "connections": [
    { "from": "input:L", "to": "flanger:in" },
    { "from": "flanger:out", "to": "output:L" },
    { "from": "flanger:out", "to": "output:R" }
  ]
}

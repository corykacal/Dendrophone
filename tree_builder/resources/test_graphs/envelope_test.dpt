{
  "dpt_version": 1,
  "audio": {
    "inputs": ["L", "R"],
    "outputs": ["L", "R"]
  },

  "nodes": {
    "input": {
      "type": "input",
      "outputs": ["L", "R"]
    },

    "lfo_trigger": {
      "type": "lfo",
      "rate": "control",
      "outputs": ["value"],
      "params": {
        "wave": "square",
        "freq_hz": 0.5,
        "depth": 1.0
      }
    },

    "env1": {
      "type": "envelope",
      "rate": "control",
      "outputs": ["value"],
      "param_inputs": ["gate", "trigger"],
      "params": {
        "envelope_type": "adsr",
        "attack_ms": 50.0,
        "decay_ms": 200.0,
        "sustain_level": 0.6,
        "release_ms": 300.0
      }
    },

    "filter": {
      "type": "svfilter",
      "inputs": ["in"],
      "outputs": ["out"],
      "param_inputs": ["cutoff"],
      "params": {
        "mode": "lowpass",
        "cutoff": 400.0,
        "resonance": 2.0,
        "mix": 1.0
      }
    },

    "output": {
      "type": "output",
      "inputs": ["L", "R"]
    }
  },

  "connections": [
    { "from": "input:L", "to": "filter:in" },

    { "from": "lfo_trigger:value", "to": "env1:gate" },

    { "from": "env1:value", "to": "filter:cutoff" },

    { "from": "filter:out", "to": "output:L" },
    { "from": "filter:out", "to": "output:R" }
  ]
}

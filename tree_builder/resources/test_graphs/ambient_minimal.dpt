{
  "dpt_version": 1,
  "audio": {
    "inputs": ["L", "R"],
    "outputs": ["L", "R"]
  },
  "nodes": {
    "input": {
      "type": "input",
      "outputs": ["L", "R"]
    },
    "lfo_detune": {
      "type": "lfo",
      "rate": "control",
      "outputs": ["value"],
      "params": {
        "wave": "sine",
        "freq_hz": 0.2,
        "depth": 0.15
      }
    },
    "lfo_filter": {
      "type": "lfo",
      "rate": "control",
      "outputs": ["value"],
      "params": {
        "wave": "triangle",
        "freq_hz": 0.1,
        "depth": 400.0
      }
    },
    "pitch_shimmer": {
      "type": "pitch_shift",
      "inputs": ["in"],
      "outputs": ["out"],
      "param_inputs": ["pitch"],
      "params": {
        "pitch": 12.0,
        "mix": 0.4
      }
    },
    "filter": {
      "type": "svfilter",
      "inputs": ["in"],
      "outputs": ["out"],
      "param_inputs": ["cutoff"],
      "params": {
        "mode": "lowpass",
        "cutoff": 800.0,
        "resonance": 2.0,
        "mix": 1.0
      }
    },
    "reverb": {
      "type": "reverb",
      "inputs": ["in"],
      "outputs": ["out"],
      "params": {
        "decay": 0.85,
        "mix": 0.6,
        "room_size": 0.95
      }
    },
    "output": {
      "type": "output",
      "inputs": ["L", "R"]
    }
  },
  "connections": [
    { "from": "input:L", "to": "pitch_shimmer:in" },
    { "from": "lfo_detune:value", "to": "pitch_shimmer:pitch" },
    { "from": "pitch_shimmer:out", "to": "filter:in" },
    { "from": "lfo_filter:value", "to": "filter:cutoff" },
    { "from": "filter:out", "to": "reverb:in" },
    { "from": "reverb:out", "to": "output:L" },
    { "from": "reverb:out", "to": "output:R" }
  ]
}

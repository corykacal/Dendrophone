{
  "dpt_version": 1,
  "audio": {
    "inputs": ["L", "R"],
    "outputs": ["L", "R"]
  },
  "nodes": {
    "input": {
      "type": "input",
      "outputs": ["L", "R"]
    },
    "lfo_cutoff": {
      "type": "lfo",
      "rate": "control",
      "outputs": ["value"],
      "params": {
        "wave": "sine",
        "freq_hz": 0.5,
        "depth": 800.0
      }
    },
    "lfo_resonance": {
      "type": "lfo",
      "rate": "control",
      "outputs": ["value"],
      "params": {
        "wave": "triangle",
        "freq_hz": 0.3,
        "depth": 3.0
      }
    },
    "filter": {
      "type": "svfilter",
      "inputs": ["in"],
      "outputs": ["out"],
      "param_inputs": ["cutoff", "resonance"],
      "params": {
        "mode": "lowpass",
        "cutoff": 500.0,
        "resonance": 1.5,
        "mix": 1.0
      }
    },
    "output": {
      "type": "output",
      "inputs": ["L", "R"]
    }
  },
  "connections": [
    { "from": "input:L", "to": "filter:in" },
    { "from": "lfo_cutoff:value", "to": "filter:cutoff" },
    { "from": "lfo_resonance:value", "to": "filter:resonance" },
    { "from": "filter:out", "to": "output:L" },
    { "from": "filter:out", "to": "output:R" }
  ]
}
